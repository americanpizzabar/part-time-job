generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model AllowanceConfig {
  id        Int      @id @default(autoincrement())
  period    String   // WEEKLY, BIWEEKLY, MONTHLY
  amount    Float
  startDate String   // "YYYY-MM-DD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AggregationConfig {
  id             Int      @id @default(autoincrement())
  periodDays     Int      @default(7)
  startDayOfWeek Int      @default(1) // 0=Sun, 1=Mon
  weeklyBudget   Int?     // 週予算(マイルストーン・チェスト判定用)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Chore {
  id          Int             @id @default(autoincrement())
  name        String
  amount      Float
  description String?
  isActive    Boolean         @default(true)
  schedules   ChoreSchedule[]
  logs        ChoreLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ChoreSchedule {
  id            Int      @id @default(autoincrement())
  chore         Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  choreId       Int
  scheduleType  String   // DAILY, WEEKLY, SPECIFIC, NONE
  daysOfWeek    String?  // JSON array of 0-6 (for WEEKLY)
  specificDates String?  // JSON array of "YYYY-MM-DD" (for SPECIFIC)
  startDate     String?  // "YYYY-MM-DD"
  endDate       String?  // "YYYY-MM-DD"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChoreLog {
  id          Int      @id @default(autoincrement())
  chore       Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  choreId     Int
  date        String   // "YYYY-MM-DD"
  completed   Boolean  @default(false)
  isExtra     Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([choreId, date, isExtra])
}

model AllowancePeriod {
  id          Int      @id @default(autoincrement())
  startDate   String   // "YYYY-MM-DD"
  endDate     String   // "YYYY-MM-DD"
  baseAmount  Float    @default(0)
  choreAmount Float    @default(0)
  totalAmount Float    @default(0)
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  notes       String?
  snapshot    String?  // JSON snapshot of chore logs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id                Int      @id @default(autoincrement())
  type              String   // INCOME | EXPENSE
  amount            Float
  category          String?  // 友達と遊ぶ, 文房具, 買い食い, 趣味, その他 (expense only)
  needsWants        String?  // NEEDS | WANTS (expense only)
  date              String   // "YYYY-MM-DD"
  reportedAt        DateTime? // ユーザー申告の時刻(放課後判定など)
  memo              String?
  imageUrl          String?  // 食事の写真など (data URL)
  isPrivate         Boolean  @default(false) // 親に詳細を見せない
  source            String   @default("MANUAL") // MANUAL | ALLOWANCE | PRESENTATION
  allowancePeriodId Int?     @unique
  presentationId    Int?     @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SavingsGoal {
  id            Int                  @id @default(autoincrement())
  name          String
  targetAmount  Float
  deadline      String?              // "YYYY-MM-DD"
  imageUrl      String?              // data URL
  isAchieved    Boolean              @default(false)
  achievedAt    DateTime?
  contributions SavingsTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SavingsTransaction {
  id        Int         @id @default(autoincrement())
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    Int
  amount    Float       // 正=積立, 負=引き出し
  date      String      // "YYYY-MM-DD"
  memo      String?
  createdAt DateTime    @default(now())
}

model PresentationRequest {
  id            Int      @id @default(autoincrement())
  itemName      String
  reason        String
  totalAmount   Float
  selfAmount    Float
  requestAmount Float
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | HOLD
  parentMessage String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  respondedAt   DateTime?
  updatedAt     DateTime @updatedAt
}

// 電子生命体 Optis の状態(シングルトン: 1レコード運用)
model OptisState {
  id               Int       @id @default(autoincrement())
  experience       Int       @default(0)
  creditScore      Int       @default(50) // 0-100
  theme            String    @default("normal") // normal | dark_web
  equippedBody     String    @default("body_core")
  equippedAura     String    @default("aura_basic")
  equippedAccessory String?  // パーツID
  unlockedParts    String    @default("[\"body_core\",\"aura_basic\"]") // JSON配列
  lastSpinDate     String?   // 直近ルーレット日 "YYYY-MM-DD"
  lastChestWeek    String?   // 直近チェスト受領週 "YYYY-MM-DD"(週開始日)
  nmdDate          String?   // ノーマネーデー申告日 "YYYY-MM-DD"
  freezeUntil      DateTime? // 凍結解除時刻(不正検知ペナルティ)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ルーレット/チェストの報酬履歴
model RewardLog {
  id        Int      @id @default(autoincrement())
  source    String   // ROULETTE | CHEST
  rarity    String   // COMMON | UNCOMMON | RARE | LEGENDARY
  rewardId  String   // パーツID or "exp:NNN"
  label     String
  date      String   // "YYYY-MM-DD"
  createdAt DateTime @default(now())
}

// 親子連動シークレット・ミッション
model Mission {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  rewardType  String    // CASH | PART
  rewardCash  Int?      // 現金報酬(円)
  rewardPart  String?   // パーツID
  status      String    @default("SENT") // SENT | CLEARED | APPROVED | REJECTED
  createdAt   DateTime  @default(now())
  clearedAt   DateTime?
  approvedAt  DateTime?
  updatedAt   DateTime  @updatedAt
}
