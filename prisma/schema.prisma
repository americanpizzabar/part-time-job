generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model AllowanceConfig {
  id        Int      @id @default(autoincrement())
  period    String   // WEEKLY, BIWEEKLY, MONTHLY
  amount    Float
  startDate String   // "YYYY-MM-DD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model AggregationConfig {
  id             Int      @id @default(autoincrement())
  periodDays     Int      @default(7)
  startDayOfWeek Int      @default(1) // 0=Sun, 1=Mon
  weeklyBudget   Int?     // 週予算(マイルストーン・チェスト判定用)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model Chore {
  id          Int             @id @default(autoincrement())
  name        String
  amount      Float
  description String?
  isActive    Boolean         @default(true)
  schedules   ChoreSchedule[]
  logs        ChoreLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model ChoreSchedule {
  id            Int      @id @default(autoincrement())
  chore         Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  choreId       Int
  scheduleType  String   // DAILY, WEEKLY, SPECIFIC, NONE
  daysOfWeek    String?  // JSON array of 0-6 (for WEEKLY)
  specificDates String?  // JSON array of "YYYY-MM-DD" (for SPECIFIC)
  startDate     String?  // "YYYY-MM-DD"
  endDate       String?  // "YYYY-MM-DD"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model ChoreLog {
  id          Int      @id @default(autoincrement())
  chore       Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  choreId     Int
  date        String   // "YYYY-MM-DD"
  completed   Boolean  @default(false)
  isExtra     Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([choreId, date, isExtra])
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model AllowancePeriod {
  id          Int      @id @default(autoincrement())
  startDate   String   // "YYYY-MM-DD"
  endDate     String   // "YYYY-MM-DD"
  baseAmount  Float    @default(0)
  choreAmount Float    @default(0)
  totalAmount Float    @default(0)
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  notes       String?
  snapshot    String?  // JSON snapshot of chore logs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model Transaction {
  id                Int      @id @default(autoincrement())
  type              String   // INCOME | EXPENSE
  amount            Float
  category          String?  // 友達と遊ぶ, 文房具, 買い食い, 趣味, その他 (expense only)
  needsWants        String?  // NEEDS | WANTS (expense only)
  assetCategory     String?  // STEM | ART_CULTURE | HEALTH_SOCIAL (NEEDS only)
  date              String   // "YYYY-MM-DD"
  reportedAt        DateTime? // ユーザー申告の時刻(放課後判定など)
  memo              String?
  imageUrl          String?  // 食事の写真など (data URL)
  isPrivate         Boolean  @default(false) // 親に詳細を見せない
  source            String   @default("MANUAL") // MANUAL | ALLOWANCE | PRESENTATION
  allowancePeriodId Int?     @unique
  presentationId    Int?     @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model SavingsGoal {
  id            Int                  @id @default(autoincrement())
  name          String
  targetAmount  Float
  deadline      String?              // "YYYY-MM-DD"
  imageUrl      String?              // data URL
  isAchieved    Boolean              @default(false)
  achievedAt    DateTime?
  contributions SavingsTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model SavingsTransaction {
  id        Int         @id @default(autoincrement())
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    Int
  amount    Float       // 正=積立, 負=引き出し
  date      String      // "YYYY-MM-DD"
  memo      String?
  createdAt DateTime    @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model PresentationRequest {
  id            Int      @id @default(autoincrement())
  itemName      String
  reason        String
  totalAmount   Float
  selfAmount    Float
  requestAmount Float
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | HOLD
  parentMessage String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  respondedAt   DateTime?
  updatedAt     DateTime @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// 電子生命体 Optis の状態(シングルトン: 1レコード運用)
model OptisState {
  id               Int       @id @default(autoincrement())
  experience       Int       @default(0)
  creditScore      Int       @default(50) // 0-100
  theme            String    @default("normal") // normal | dark_web
  equippedBody     String    @default("body_core")
  equippedAura     String    @default("aura_basic")
  equippedAccessory String?  // パーツID
  unlockedParts    String    @default("[\"body_core\",\"aura_basic\"]") // JSON配列
  lastSpinDate     String?   // 直近ルーレット日 "YYYY-MM-DD"
  lastChestWeek    String?   // 直近チェスト受領週 "YYYY-MM-DD"(週開始日)
  nmdDate          String?   // ノーマネーデー申告日 "YYYY-MM-DD"
  freezeUntil      DateTime? // 凍結解除時刻(不正検知ペナルティ)
  awakening        Int       @default(0) // Needs(自己投資)購入で蓄積する覚醒値
  gcoins           Int       @default(0) // ゲーム内仮想コイン(バンク/ショップ用)
  generation       Int       @default(1) // 転生(結晶化)回数 + 1
  langMode         String    @default("JA") // 英語モード: JA | EN
  wisdomPoints     Int       @default(0) // 知性ポイント
  mercariTotal     Int       @default(0) // メルカリ等で自力で稼いだ累計(能動的収入)
  traderUnlocked   Boolean   @default(false) // 商人(トレーダー)属性の解放
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// マイ・プロジェクト(クラファン型 親子マッチング投資)
model Project {
  id               Int                   @id @default(autoincrement())
  name             String
  imageUrl         String?
  targetAmount     Int                   // 目標総額
  selfTarget       Int                   // 自己原資の目標
  parentBoostTotal Int                   // 親の出資総額
  plannedAmount    Int                   // 計画的に1回で回す額
  selfSaved        Int                   @default(0) // 自分で積み立てた累計
  boostReleased    Int                   @default(0) // 親が放出済みの累計
  status           String                @default("PENDING") // PENDING | ACTIVE | COMPLETED | REJECTED
  parentMessage    String?
  createdAt        DateTime              @default(now())
  approvedAt       DateTime?
  completedAt      DateTime?
  updatedAt        DateTime              @updatedAt
  contributions    ProjectContribution[]
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model ProjectContribution {
  id          Int      @id @default(autoincrement())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  amount      Int
  type        String   // SELF | BOOST
  boostStatus String?  // SELF積立がブースト待ち/放出済か: PENDING | RELEASED
  date        String   // "YYYY-MM-DD"
  createdAt   DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ルーレット/チェストの報酬履歴
model RewardLog {
  id        Int      @id @default(autoincrement())
  source    String   // ROULETTE | CHEST
  rarity    String   // COMMON | UNCOMMON | RARE | LEGENDARY
  rewardId  String   // パーツID or "exp:NNN"
  label     String
  date      String   // "YYYY-MM-DD"
  createdAt DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// 装備セット（コーデ）保存
model OutfitSet {
  id                Int      @id @default(autoincrement())
  name              String
  equippedBody      String
  equippedAura      String
  equippedAccessory String?
  createdAt         DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// 親子連動シークレット・ミッション
model Mission {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  rewardType  String    // CASH | PART
  rewardCash  Int?      // 現金報酬(円)
  rewardPart  String?   // パーツID
  status      String    @default("SENT") // SENT | CLEARED | APPROVED | REJECTED
  createdAt   DateTime  @default(now())
  clearedAt   DateTime?
  approvedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── ギルド(バジェット同盟) ──────────────────────────────────────────
model Guild {
  id         Int               @id @default(autoincrement())
  name       String
  inviteCode String            @unique
  auraColor  String            @default("#06b6d4")
  createdAt  DateTime          @default(now())
  members    GuildMembership[]
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model GuildMembership {
  id             Int      @id @default(autoincrement())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId        Int
  nickname       String
  isOwner        Boolean  @default(false)
  budgetMetWeek  String?  // ISO週番号 "YYYY-Www" - 予算達成した週
  createdAt      DateTime @default(now())

  @@unique([guildId, nickname])
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── パーツトレード(近距離トークン交換) ─────────────────────────────
model TradeOffer {
  id          Int      @id @default(autoincrement())
  offerPartId String   // 渡すパーツ
  wantPartId  String?  // 希望パーツ(null=おまかせ)
  token       String   @unique
  status      String   @default("OPEN") // OPEN | COMPLETED | EXPIRED
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── 成果報告(エンジェル投資リターン) ────────────────────────────────
model OutcomeReport {
  id         Int      @id @default(autoincrement())
  projectId  Int
  content    String
  imageUrl   String?
  metric     String?  // "テスト+10点" など
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rewardPart String?  // 承認時に解放するパーツID
  parentNote String?
  createdAt  DateTime @default(now())
  approvedAt DateTime?
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── ダイナミック・マーケット(パーツ価格変動) ─────────────────────────
model PartMarketPrice {
  id           Int      @id @default(autoincrement())
  partId       String
  currentPrice Int
  totalBought  Int      @default(0)
  totalSold    Int      @default(0)
  updatedAt    DateTime @updatedAt
  history      Json     @default("[]") // [{date,price}]
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@unique([familyId, partId])
  @@index([familyId])
}

// ─── メモリーキューブ(転生記録) ────────────────────────────────────────
model MemoryCube {
  id             Int      @id @default(autoincrement())
  generation     Int
  form           String
  stage          Int
  level          Int
  awakening      Int
  creditScore    Int
  crystallizedAt DateTime @default(now())
  nickname       String?
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── ファミリー・クレジット(家族間ローン) ────────────────────────────
model FamilyLoan {
  id               Int      @id @default(autoincrement())
  purpose          String
  principal        Int
  months           Int
  monthlyPayment   Int
  interestPerMonth Int      @default(0)
  paidMonths       Int      @default(0)
  status           String   @default("PENDING") // PENDING | ACTIVE | COMPLETED | REJECTED
  parentNote       String?
  createdAt        DateTime @default(now())
  approvedAt       DateTime?
  completedAt      DateTime?
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── シャドウ・フィード(世界ハック情報) ──────────────────────────────
model FeedItem {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  category    String   @default("NEWS") // NEWS | ALERT | BOOST | TREND
  effectJson  String?  // JSON: {"type":"exp_multiplier","category":"書籍","multiplier":2,"expiresAt":"YYYY-MM-DD"}
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── タイムワープ・バンク(仮想銀行) ──────────────────────────────────
model VirtualBankDeposit {
  id             Int      @id @default(autoincrement())
  principal      Int      // 預け入れGコイン数
  depositDate    String   // "YYYY-MM-DD"
  maturityDate   String   // "YYYY-MM-DD"(7日後)
  ratePercent    Int      @default(10) // 週利(%)
  status         String   @default("ACTIVE") // ACTIVE | MATURED | WITHDRAWN
  interestEarned Int      @default(0)
  createdAt      DateTime @default(now())
  settledAt      DateTime?
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── 時事クイズ + 経済ウェザー ────────────────────────────────────────
model EconomicWeather {
  id          Int      @id @default(autoincrement())
  type        String   // NEUTRAL | INFLATION | DEFLATION | YEN_STRONG | YEN_WEAK | RATE_HIKE
  magnitude   Float    @default(1.0)
  description String
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model NewsQuiz {
  id           Int           @id @default(autoincrement())
  question     String
  options      String        // JSON array of 3 strings
  correctIndex Int
  explanation  String
  weatherType  String        @default("NEUTRAL")
  isActive     Boolean       @default(true)
  layer        Int           @default(1) // 1=高校受験 2=大学受験 3=ビジネス/GMAT
  genre        String        @default("CURRENT") // CURRENT(時事) | ECONOMY(経済) | ENGLISH(英語) | LOGIC(論理)
  createdAt    DateTime      @default(now())
  attempts     QuizAttempt[]
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model QuizAttempt {
  id           Int      @id @default(autoincrement())
  quiz         NewsQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId       Int
  selectedIndex Int
  correct      Boolean
  shieldUntil  DateTime? // 正解時: now + 7日
  expGained    Int      @default(0)
  responseMs   Int?     // 回答までの時間(ms)
  layer        Int      @default(1) // 出題時の難易度レイヤー
  genre        String   @default("CURRENT") // 出題ジャンル(履歴・分析用)
  questionText String?  // 出題時の問題文スナップショット(履歴表示用)
  createdAt    DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── 模擬インデックスファンド ──────────────────────────────────────────
model IndexFund {
  id             Int      @id @default(autoincrement())
  invested       Int      @default(0)  // 累計投資額(円)
  currentValue   Int      @default(0)  // 現在評価額(円)
  parentMatchRate Int     @default(0)  // 親マッチ率(%)
  baseReturnRate  Int     @default(5)  // 年利(%)
  lastReturnAt   String?              // "YYYY-MM-DD" 最終リターン適用日
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  txs            IndexFundTx[]
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

model IndexFundTx {
  id        Int       @id @default(autoincrement())
  fund      IndexFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  fundId    Int
  amount    Int
  type      String    // INVEST | WITHDRAW | RETURN | PARENT_BONUS
  date      String    // "YYYY-MM-DD"
  memo      String?
  createdAt DateTime  @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── 1日1キーワード(知性フラッシュ) ──────────────────────────────────
model DailyKeyword {
  id        Int      @id @default(autoincrement())
  word      String   // "円安"
  ruby      String?  // "えんやす"
  english   String?  // "Yen Depreciation"
  emoji     String   @default("💡")
  gradient  String   @default("economy") // economy|tech|global|cyber|social
  body      String   // "1ドル=160円時代。輸入品が値上がりし、家計に直撃。"
  date      String   // "YYYY-MM-DD" 表示予定日
  createdAt DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── ワン・ワード・ミッション(英語パズル) ────────────────────────────
model WordMission {
  id           Int       @id @default(autoincrement())
  word         String    // "Budget"
  translation  String    // "予算"
  choices      Json      // ["Budget","Target","Balance"]
  correctIndex Int
  hint         String    // "暗号が解除されると◯◯◯◯◯が受け取れる"
  expReward    Int       @default(30)
  isActive     Boolean   @default(true)
  solvedAt     DateTime?
  createdAt    DateTime  @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── 自律式ラーニングプロファイル(シングルトン) ────────────────────
model LearningProfile {
  id             Int       @id @default(autoincrement())
  layer          Int       @default(1)   // 現在の難易度レイヤー: 1=高校 2=大学 3=ビジネス
  encounterRate  Float     @default(0.3) // クイズ出現率 (0.05–0.8)
  lastAnsweredAt DateTime?
  layerUpAt      DateTime?              // 最終レイヤーアップ日時
  layerUpSeen    Boolean   @default(true)  // レイヤーアップ演出済みフラグ
  parentAlertAt  DateTime?              // 親通知発火日時
  parentBoosted  Boolean   @default(false) // 親がブースト済み
  // 親側の出題範囲・レベル管理設定
  genreCurrent   Boolean   @default(true) // 時事・社会 ON/OFF
  genreEconomy   Boolean   @default(true) // 経済・金融 ON/OFF
  genreEnglish   Boolean   @default(true) // 国際・英語 ON/OFF
  genreLogic     Boolean   @default(true) // ロジカル思考 ON/OFF
  levelCap       Int       @default(0)   // 上限レイヤー(0=制限なし/自動, 1=高校まで, 2=大学まで, 3=大人まで)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── メルカリ(フリマ)売上 ─────────────────────────────────────────────
model MercariSale {
  id        Int      @id @default(autoincrement())
  itemName  String?  // 売れた商品名(任意)
  amount    Int      // 売上金額(円)
  date      String   // "YYYY-MM-DD"
  transactionId Int? // 紐づく収入トランザクション(編集・削除時に同期)
  createdAt DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── バックアップ・スナップショット(復元コード方式) ────────────────────────
model BackupSnapshot {
  id          Int      @id @default(autoincrement())
  payload     String   // 全状態のJSONスナップショット
  restoreCode String?  @unique // 親発行の復元コード(英数6桁)
  note        String?  // ラベル(例: "機種変更前")
  issuedBy    String   @default("PARENT") // PARENT | AUTO
  createdAt   DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── マーケット取引履歴(裏モードの投資成績 P&L 計算用) ──────────────────────
model MarketTrade {
  id        Int      @id @default(autoincrement())
  partId    String
  action    String   // BUY | SELL
  price     Int      // 支払/受取した Gコイン
  date      String   // "YYYY-MM-DD"
  createdAt DateTime @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── データ・デコード(裏モードのインテリジェンス暗号解読) ────────────────────
// 統計/グラフ読解(DATA)と疑似コード穴埋め(ALGO)を1タップで解くハッキング風ミッション
model DecodeMission {
  id           Int       @id @default(autoincrement())
  kind         String    // DATA(データ読解) | ALGO(疑似コード)
  title        String    // ミッション名
  brief        String    // Optisの導入セリフ
  dataset      String?   // CSV風/グラフ断片のテキスト(任意)
  question     String
  choices      Json      // string[]
  correctIndex Int
  explanation  String
  expReward    Int       @default(40)
  gcoinReward  Int       @default(15)
  rewardPartId String?   // 初回クリアで解放するバグパーツID(任意)
  isActive     Boolean   @default(true)
  solvedAt     DateTime?
  createdAt    DateTime  @default(now())
  familyId  String   @default("default-family") // マルチテナント: 家族コンテナID

  @@index([familyId])
}

// ─── マルチテナント(家族コンテナ) ─────────────────────────────────────
// 全データは FamilyID に紐づき、他家族からのアクセスは prisma.ts の
// テナントガードがサーバー側で一律遮断する。
model Family {
  id               String         @id @default(cuid())
  name             String         @default("マイファミリー")
  recoveryCodeHash String?        // bcrypt ハッシュ(平文は保存しない)
  createdAt        DateTime       @default(now())
  members          FamilyMember[]
  codes            PairingCode[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String
  role      String   // PARENT | CHILD
  nickname  String   @default("")
  token     String   @unique // 端末セッショントークン(httpOnly Cookie)
  createdAt DateTime @default(now())

  @@index([familyId])
}

// 親子ペアリング用ワンタイムコード(6桁・有効期限10分・1回使い切り)
model PairingCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique // 6桁数字
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String
  role      String    @default("CHILD") // 参加者のロール: PARENT | CHILD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
